{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "ReviewPhaseAuditBatchReceipt",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "baseline",
    "auditDate",
    "section",
    "gates",
    "auditedFiles",
    "verdicts",
    "findings"
  ],
  "properties": {
    "baseline": {
      "type": "string",
      "minLength": 40,
      "maxLength": 40
    },
    "auditDate": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "section": {
      "type": "string",
      "minLength": 1
    },
    "gates": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "enum": [
          "security",
          "data-integrity",
          "performance",
          "architecture",
          "subtraction"
        ]
      }
    },
    "auditedFiles": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "verdicts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "file",
          "gates"
        ],
        "properties": {
          "file": {
            "type": "string",
            "minLength": 1
          },
          "gates": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "gate",
                "status",
                "reason"
              ],
              "properties": {
                "gate": {
                  "type": "string",
                  "enum": [
                    "security",
                    "data-integrity",
                    "performance",
                    "architecture",
                    "subtraction"
                  ]
                },
                "status": {
                  "type": "string",
                  "enum": [
                    "clean",
                    "n/a",
                    "finding"
                  ]
                },
                "reason": {
                  "type": "string",
                  "minLength": 1
                }
              }
            }
          }
        }
      }
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "lens",
          "severity",
          "title",
          "files",
          "where",
          "what",
          "fix",
          "acceptance",
          "priority",
          "verified",
          "verifyNote"
        ],
        "properties": {
          "lens": {
            "type": "string",
            "enum": [
              "security",
              "data-integrity",
              "performance",
              "architecture",
              "subtraction"
            ]
          },
          "severity": {
            "type": "string",
            "enum": [
              "critical",
              "high",
              "medium",
              "low"
            ]
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "files": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "pattern": ":\\d+(?:-\\d+)?$"
            }
          },
          "where": {
            "type": "string",
            "minLength": 1
          },
          "what": {
            "type": "string"
          },
          "fix": {
            "type": "string",
            "minLength": 1
          },
          "acceptance": {
            "type": "string",
            "minLength": 1
          },
          "priority": {
            "type": "string",
            "enum": [
              "High",
              "Medium",
              "Low"
            ]
          },
          "verified": {
            "type": "boolean",
            "const": true
          },
          "verifyNote": {
            "type": "string",
            "minLength": 1
          },
          "cut": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "blastRadius": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "keepIf": {
            "type": "string",
            "minLength": 1
          },
          "reversibility": {
            "type": "string",
            "minLength": 1
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "lens": {
                  "const": "subtraction"
                }
              },
              "required": [
                "lens"
              ]
            },
            "then": {
              "properties": {
                "cut": {},
                "blastRadius": {},
                "keepIf": {},
                "reversibility": {}
              },
              "required": [
                "cut",
                "blastRadius",
                "keepIf",
                "reversibility"
              ]
            },
            "else": {
              "properties": {
                "cut": false,
                "blastRadius": false,
                "keepIf": false,
                "reversibility": false
              }
            }
          }
        ]
      }
    }
  }
}
